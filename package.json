{
  "name": "recipe-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:api": "tsx api/src/index.ts",
    "build:api": "tsc -p api/tsconfig.json",
    "prepare:data": "tsx scripts/prepare-data-cli.ts",
    "import:data": "tsx scripts/import-data.ts",
    "migrate:accounts": "tsx scripts/migrate-account-schema.ts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "google-auth-library": "^10.5.0",
    "neo4j-driver": "^6.3.0",
    "nodemailer": "^10.5.0",
    "zod": "^4.6.7"
  }
}
