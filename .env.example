# Set a strong local password before starting Compose.
NEO4J_PASSWORD=
NEO4J_USER=neo4j
NEO4J_URI=bolt://localhost:7687

# Optional local settings.
NEO4J_BOLT_PORT=7687
NEO4J_DATABASE=neo4j
API_PORT=3000
PREPARED_DATA_DIR=./data/prepared
APP_PORT=8080

# Local verification email is captured by Mailpit.
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@local.test
SMTP_HOST=mailpit
SMTP_PORT=1025
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Use at least 32 random characters; hashes verification codes and source IPs.
VERIFICATION_CODE_SECRET=

# Google sign-in uses a verified backend client ID. Leave unset to disable Google auth.
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_IDS=your-client-id,another-client-id
